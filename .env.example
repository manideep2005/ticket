# ---------------------------------------------------------------------------
# Frontend configuration — copy to `.env.local` and fill in with your GCP settings:
#   cp .env.example .env.local
#
# IMPORTANT: anything prefixed with VITE_ is compiled into the browser bundle.
# Only public, non-secret values belong here. Service account keys, database secrets,
# and OAuth client secrets must NEVER appear in this file. They live in Google Cloud
# Secret Manager / Cloud Run environment variables for the backend only.
# ---------------------------------------------------------------------------

# Base URL of the deployed Google Cloud backend (Cloud Run or Cloud Functions).
# Leave EMPTY when fronted by Cloud Load Balancing / reverse proxy with /api on the same origin.
# Example values:
#   http://localhost:8080                                (local backend server)
#   https://supporthub-api-xyz-uc.a.run.app              (Google Cloud Run)
#   https://api.yourdomain.com                           (production custom domain)
VITE_API_BASE_URL=

# Google OAuth 2.0 Web Client ID from Google Cloud Console:
# APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web application
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Comma-separated list of admin emails (used for initial role resolution):
# Example: admin@yourcompany.com,lead@yourcompany.com
VITE_ADMIN_EMAILS=

# Comma-separated list of agent emails:
# Example: support@yourcompany.com,agent1@yourcompany.com
VITE_AGENT_EMAILS=

# Production portal URL:
# VITE_SUPPORT_PORTAL_URL=https://support.yourdomain.com
