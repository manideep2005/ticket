# ---------------------------------------------------------------------------
# Frontend configuration — copy to `.env.local` and fill in when Azure is ready.
#   cp .env.example .env.local
#
# IMPORTANT: anything prefixed with VITE_ is compiled into the browser bundle.
# Only public, non-secret values belong here. Cosmos DB keys, Service Bus
# connection strings, ACS connection strings and Entra client secrets must
# NEVER appear in this file — they live in Azure app settings / Key Vault and
# are used by the Functions backend only.
# ---------------------------------------------------------------------------

# Base URL of the deployed Azure Functions API.
# Leave EMPTY when the UI is deployed as an Azure Static Web App and /api is
# same-origin (the normal case).
# Example values:
#   https://<your-functions-app>.azurewebsites.net
#   https://api.<your-domain>.com          (when fronted by API Management)
VITE_API_BASE_URL=

# Placeholders for later phases (see docs/API-FIRST-PLATFORM.md):
# VITE_AUTH_AUTHORITY=https://login.microsoftonline.com/<tenant-id>     # Entra ID
# VITE_AUTH_CLIENT_ID=<spa-app-registration-client-id>                  # public client, no secret
# VITE_SUPPORT_PORTAL_URL=https://support.<your-domain>.com
