{
  "_comment": "Copy to local.settings.json (git-ignored) for the Azure Functions backend. Values shown as <PLACEHOLDER> are filled in when the Azure resources exist. Prefer managed identity over keys — the key-based rows are marked OPTIONAL ONLY FOR LOCAL DEV.",
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "FUNCTIONS_EXTENSION_VERSION": "~4",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "AZURE_TENANT_ID": "<ENTRA-TENANT-ID>",
    "API_AUDIENCE": "api://<API-APP-REGISTRATION-CLIENT-ID>",

    "COSMOS_ACCOUNT_ENDPOINT": "https://<cosmos-account>.documents.azure.com:443/",
    "COSMOS_DATABASE_NAME": "supportplatform",
    "COSMOS_TICKETS_CONTAINER": "tickets",
    "COSMOS_MESSAGES_CONTAINER": "messages",
    "COSMOS_AUDIT_CONTAINER": "audit",

    "SERVICE_BUS_NAMESPACE": "<servicebus-namespace>.servicebus.windows.net",
    "SERVICE_BUS_ROUTING_QUEUE": "ticket-routing",

    "ACS_EMAIL_SENDER": "DoNotReply@<your-verified-domain>",
    "ACS_EMAIL_DISPLAY_NAME": "SupportHub",

    "APPLICATIONINSIGHTS_CONNECTION_STRING": "<app-insights-connection-string>",

    "_OPTIONAL_LOCAL_DEV_ONLY": "Prefer managed identity (DefaultAzureCredential). Use these keys ONLY for local development, never for deployed environments, and never in a public repo.",
    "COSMOS_KEY": "<cosmos-primary-or-secondary-key>",
    "SERVICE_BUS_CONNECTION_STRING": "<servicebus-connection-string>",
    "ACS_CONNECTION_STRING": "<acs-connection-string>"
  }
}
