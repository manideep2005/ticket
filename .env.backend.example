# ---------------------------------------------------------------------------
# Backend configuration template for Google Cloud Platform
# (Cloud Functions 2nd Gen / Cloud Run Node.js service)
# ---------------------------------------------------------------------------

# Port for local backend server / Cloud Run container
PORT=8080

# Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Region
GCP_REGION=us-central1

# Google OAuth 2.0 Web Client ID (matches frontend VITE_GOOGLE_CLIENT_ID for token validation)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Firestore Configuration
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_TICKETS_COLLECTION=tickets
FIRESTORE_MESSAGES_COLLECTION=messages
FIRESTORE_USERS_COLLECTION=users

# Google Cloud Pub/Sub Configuration
PUBSUB_TOPIC_TICKET_CREATED=ticket-created
PUBSUB_SUBSCRIPTION_TICKET_ROUTING=ticket-routing-sub

# Email Notification Provider (SendGrid / Mailgun API key stored securely or via Secret Manager)
SENDGRID_API_KEY=
EMAIL_SENDER_ADDRESS=support@yourdomain.com
EMAIL_SENDER_NAME=SupportHub

# Optional: Path to service account key ONLY FOR LOCAL DEVELOPMENT.
# In GCP Cloud Run / Cloud Functions, leave this unset — GCP uses Application Default
# Credentials (ADC) via the service's attached Service Account automatically!
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
