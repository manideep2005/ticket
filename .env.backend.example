# ---------------------------------------------------------------------------
# Backend configuration template for Google Cloud Platform
# (Cloud Functions 2nd Gen / Cloud Run Node.js service)
#
# Copy to `.env.backend` and fill in your values:
#   cp .env.backend.example .env.backend
#
# SECURITY NOTES:
#  - .env.backend is gitignored. NEVER commit real secrets or email addresses.
#  - In Cloud Run / Cloud Functions, set these as environment variables in the
#    GCP Console or via `gcloud run deploy --set-env-vars`.
#  - In production, store secrets in Google Cloud Secret Manager and reference
#    them as environment variables in your Cloud Run service.
# ---------------------------------------------------------------------------

# Port for local backend server / Cloud Run container
PORT=8080

# Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Region
GCP_REGION=us-central1

# Google OAuth 2.0 Web Client ID (matches frontend VITE_GOOGLE_CLIENT_ID for token validation)
# Required. Without this, the backend cannot verify Google ID tokens and all
# authenticated requests will be rejected with 401.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# ADMIN_EMAIL — Initial Administrator Bootstrap (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave this empty during development when your group is not ready to assign
# a specific administrator. Sign-in will still work and new users are
# automatically assigned the Customer role.
#
# When your group is ready to configure the first Admin:
#  1. Agree on which team member's Google account will be the initial Admin.
#  2. Set ADMIN_EMAIL to that person's Google account email (lowercase).
#  3. Restart the backend.
#  4. That person signs in — they are promoted to Admin on first login.
#  5. The Admin can then promote other team members via User Management.
#  6. Once another Admin exists, ADMIN_EMAIL can be cleared or left as-is
#     (it only promotes once per account due to the bootstrapped flag).
#
# IMPORTANT RULES:
#  - ADMIN_EMAIL is optional. Omitting it does not disable authentication or
#    weaken authorization — it only means no account is auto-promoted to Admin.
#  - No account is silently promoted if this value is empty or unset.
#  - Do NOT put this value in any VITE_* variable or .env.local.
#  - Do NOT hardcode actual email addresses in source code.
#  - If you need to re-bootstrap after demotion, see store.json migration notes
#    in the implementation report.
#
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Firestore Configuration
# ---------------------------------------------------------------------------
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_TICKETS_COLLECTION=tickets
FIRESTORE_MESSAGES_COLLECTION=messages
FIRESTORE_USERS_COLLECTION=users

# Google Cloud Pub/Sub Configuration
PUBSUB_TOPIC_TICKET_CREATED=ticket-created
PUBSUB_SUBSCRIPTION_TICKET_ROUTING=ticket-routing-sub

# Email Notification Provider (SendGrid / Mailgun API key stored securely or via Secret Manager)
SENDGRID_API_KEY=
EMAIL_SENDER_ADDRESS=support@yourdomain.com
EMAIL_SENDER_NAME=SupportHub

# Optional: Path to service account key ONLY FOR LOCAL DEVELOPMENT.
# In GCP Cloud Run / Cloud Functions, leave this unset — GCP uses Application Default
# Credentials (ADC) via the service's attached Service Account automatically!
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
